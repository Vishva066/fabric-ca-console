# ─────────────────────────────────────────────
# Fabric CA Backend — Environment Variables
# Copy this file to .env and fill in the values
# ─────────────────────────────────────────────

# URL of the Fabric CA server
# Default: https://localhost:7054
FABRIC_CA_SERVER_URL=https://localhost:7054

# Path to the admin enrollment certificate (PEM)
# Default: ./crypto/cert.pem
FABRIC_REGISTRAR_CERT_PATH=./crypto/cert.pem

# Path to the admin private key (PEM)
# Default: ./crypto/key.pem
FABRIC_REGISTRAR_KEY_PATH=./crypto/key.pem

# Path to the TLS root CA certificate used to verify the CA server's TLS connection
# Default: ./crypto/tls-cert.pem
FABRIC_CA_CONNECT_TLS_CERT=./crypto/tls-cert.pem

# Optional path to a separate/dedicated TLS CA's root certificate (multi-CA setups
# where the TLS CA is a different fabric-ca instance from the signing CA). Used
# for identities' tlscacerts MSP folder. Leave empty to auto-fetch the live
# CAChain from the CA's /cainfo endpoint instead (covers the common case where
# the enrollment CA also issues TLS certs).
# No default — must be explicitly set.
FABRIC_TLSCA_ROOT_CERT=

# Base directory where MSP folder structures are created for enrolled identities
# Folder layout: <FABRIC_CERT_BASE_DIR>/organizations/<org_name>/<identity_type>/<id>/msp/
# Default: . (current directory)
FABRIC_CERT_BASE_DIR=.

# CORS Allowed Origins
# Default: http://localhost:3001
CORS_ALLOW_ORIGINS=http://localhost:3001
